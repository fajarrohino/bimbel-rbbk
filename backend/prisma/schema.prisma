// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ADMIN
// ============================================================

model AdminUser {
  id           String         @id @default(uuid())
  username     String         @unique
  passwordHash String         @map("password_hash")
  role         String         @default("owner")
  isActive     Boolean        @default(true) @map("is_active")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  sessions     AdminSession[]

  @@map("admin_users")
}

model AdminSession {
  id               String    @id @default(uuid())
  adminUserId      String    @map("admin_user_id")
  refreshTokenHash String    @map("refresh_token_hash")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  adminUser        AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@map("admin_sessions")
}

// ============================================================
// PROGRAMS
// ============================================================

model Program {
  id             String           @id @default(uuid())
  name           String
  description    String
  gradeLevels    String           @map("grade_levels")
  subjects       String
  fee            Decimal          @db.Decimal(12, 2)
  isActive       Boolean          @default(true) @map("is_active")
  displayOrder   Int              @map("display_order")
  isDeleted      Boolean          @default(false) @map("is_deleted")
  deletedAt      DateTime?        @map("deleted_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  studentPrograms StudentProgram[]

  @@map("programs")
}

// ============================================================
// STUDENTS
// ============================================================

enum StudentStatus {
  Pending
  Aktif
  Nonaktif
  Lulus
}

enum Gender {
  Laki_laki @map("Laki-laki")
  Perempuan
}

model Student {
  id               String              @id @default(uuid())
  name             String
  gender           Gender
  birthDate        DateTime            @map("birth_date") @db.Date
  grade            String
  school           String
  parentName       String              @map("parent_name")
  whatsapp         String
  preferredSession Int?                @map("preferred_session")
  status           StudentStatus       @default(Pending)
  note             String?
  rejectionReason  String?             @map("rejection_reason")
  isDeleted        Boolean             @default(false) @map("is_deleted")
  deletedAt        DateTime?           @map("deleted_at")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")
  studentPrograms  StudentProgram[]
  schedules        ScheduleAssignment[]

  @@map("students")
}

// ============================================================
// STUDENT PROGRAMS (history)
// ============================================================

enum StudentProgramStatus {
  Aktif
  Selesai
}

model StudentProgram {
  id                       String               @id @default(uuid())
  studentId                String               @map("student_id")
  programId                String               @map("program_id")
  programNameAtRegistration String              @map("program_name_at_registration")
  feeAtRegistration        Decimal              @map("fee_at_registration") @db.Decimal(12, 2)
  status                   StudentProgramStatus @default(Aktif)
  startedAt                DateTime             @default(now()) @map("started_at")
  note                     String?
  createdAt                DateTime             @default(now()) @map("created_at")
  updatedAt                DateTime             @updatedAt @map("updated_at")
  student                  Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  program                  Program              @relation(fields: [programId], references: [id])

  @@map("student_programs")
}

// ============================================================
// SCHEDULE ASSIGNMENTS
// ============================================================

model ScheduleAssignment {
  id        String   @id @default(uuid())
  studentId String   @map("student_id")
  date      DateTime @db.Date
  session   Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, date, session])
  @@map("schedule_assignments")
}
