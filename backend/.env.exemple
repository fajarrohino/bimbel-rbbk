# =======================
# DATABASE
# =======================
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require"

# =======================
# JWT SECRETS
# =======================
# Gunakan string acak yang panjang dan aman (min 32 karakter)
# JWT_ACCESS_SECRET="ganti-dengan-secret-access-token-yang-aman-dan-panjang"
# JWT_REFRESH_SECRET="ganti-dengan-secret-refresh-token-yang-berbeda-dan-aman"

# =======================
# TOKEN EXPIRY
# =======================
JWT_ACCESS_EXPIRES_IN="15m"
# Refresh token dalam detik: 86400 = 24 jam
# JWT_REFRESH_EXPIRES_SECONDS="86400"

# =======================
# SERVER
# =======================
# PORT="3001"
# HOST="0.0.0.0"
# NODE_ENV="development"

# =======================
# CORS
# =======================
# CORS_ORIGIN="http://localhost:3000"
